# Local workspace (tasks, overrides, artifacts)
.local/

# Ephemeral Cursor task rules
.cursor/rules/_task-active.mdc

# Environment and secrets
.env
.env.*
!.env.example

# OS and IDE (non-Cursor)
.DS_Store
.idea/
*.swp

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Rust (workspace root target dir covers all crates)
target/
**/*.rs.bk

# Blender working files (factory outputs in content/assets/ are gated GLBs only)
*.blend1
*.blend2
