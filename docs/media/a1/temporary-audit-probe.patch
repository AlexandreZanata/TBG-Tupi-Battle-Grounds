+// Temporary step-1 probe; removed before the audit commit.
+fn audit_counts(
+    units: Query<(Entity, &UnitVisual)>,
+    children: Query<&Children>,
+    mut seen: Local<std::collections::HashSet<(UnitKind, u8, u8)>>,
+) {
+    if crate::config::url_param("audit").is_none() { return; }
+    for (entity, visual) in &units {
+        if !seen.insert(visual.form) { continue; }
+        let mut stack = vec![entity];
+        let mut count = 0;
+        while let Some(entity) = stack.pop() {
+            count += 1;
+            if let Ok(children) = children.get(entity) { stack.extend(children.iter()); }
+        }
+        info!("A1_ENTITIES form={:?} count={count}", visual.form);
+    }
+}
