{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "orderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "catalogRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "currency": {
      "const": "BRL"
    },
    "amountMinor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "refundedMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paymentState": {
      "enum": [
        "pending",
        "creation_unknown",
        "received"
      ]
    },
    "holdState": {
      "enum": [
        "none",
        "held",
        "cleared"
      ]
    },
    "fulfillmentState": {
      "enum": [
        "pending",
        "applied",
        "compensated"
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lineId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "quantity": {
            "const": 1
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "lineId",
          "sku",
          "quantity",
          "amountMinor"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "orderId",
    "accountId",
    "catalogRevision",
    "currency",
    "amountMinor",
    "refundedMinor",
    "paymentState",
    "holdState",
    "fulfillmentState",
    "lines"
  ]
}
