{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "purpose": {
      "enum": [
        "verify_recovery_email",
        "rotate_account_key"
      ]
    },
    "tokenDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "active",
        "consumed",
        "expired"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "accountId",
    "purpose",
    "tokenDigest",
    "state",
    "issuedAt",
    "expiresAt"
  ]
}
