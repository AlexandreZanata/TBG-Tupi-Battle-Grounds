{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tbg.local/library/_schema.recipe.json",
  "title": "TBG assembly recipe",
  "type": "object",
  "required": ["unitId", "baseId", "parts", "materialId"],
  "additionalProperties": false,
  "properties": {
    "unitId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "baseId": { "type": "string", "enum": ["male", "female", "small", "large"] },
    "parts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "materialId": { "type": "string", "pattern": "^[a-z0-9_]+$" }
  }
}
