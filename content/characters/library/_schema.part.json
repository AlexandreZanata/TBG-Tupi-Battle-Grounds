{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tbg.local/library/_schema.part.json",
  "title": "TBG part manifest",
  "type": "object",
  "required": ["id", "category", "baseCompat", "socket", "mesh", "thumbnail"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "category": {
      "type": "string",
      "enum": ["heads", "hair", "hats", "noses", "beards", "armor", "backpacks", "weapons", "wings", "tails"]
    },
    "baseCompat": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["male", "female", "small", "large"] },
      "uniqueItems": true
    },
    "socket": { "type": "string", "pattern": "^TBG_" },
    "mesh": { "type": "string", "pattern": "\\.glb$" },
    "thumbnail": { "type": "string", "pattern": "\\.webp$" }
  }
}
