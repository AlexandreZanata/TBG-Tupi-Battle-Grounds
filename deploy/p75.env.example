# Placeholders only. Owner-managed /etc/tbg/p75.env must be mode 0600.
TBG_ADMIN=on
TBG_ADMIN_ORIGIN=https://admin.tupibg.com
TBG_ADMIN_ADDR=127.0.0.1:8090
TBG_ADMIN_PORT_A=8090
TBG_ADMIN_PORT_B=8092
TBG_ADMIN_LOGIN_CODE=on
TBG_ADMIN_BOOTSTRAP_EMAIL=<owner-address>
TBG_PUBLIC_GAME_URL=https://app.tupibg.com
TBG_PUBLIC_ADMIN_URL=https://admin.tupibg.com
TBG_MAIL_FROM=<reviewed-sender>
TBG_SMTP_HOST=<smtp-host>
TBG_SMTP_PORT=587
TBG_SMTP_SECURITY=starttls
TBG_SMTP_USERNAME=<smtp-login>
TBG_SMTP_PASSWORD_CREDENTIAL=smtp_password
TBG_FEED_MS=1000
# TBG_ADMIN_ALLOW_IPS=<reviewed-cidr-list>
# The password belongs only in the systemd credential file, never here.
