__TBG_DOMAIN__ {
	encode zstd gzip
	handle /ws {
		reverse_proxy 127.0.0.1:8080
	}
	handle /health {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * /srv/tbg/web
		@hashed path *.wasm *.js
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		file_server
	}
}
