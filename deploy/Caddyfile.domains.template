# API plus browser app; Caddy >= 2.8. Cloudflare ranges checked 2026-11-01.
# https://www.cloudflare.com/ips-v4 and /ips-v6; refresh on proxy range changes.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

# Only verified proxy peers can supply a client IP. Each upstream receives
# exactly that IP, including direct requests, so forged XFF never wins.
(tbg_api) {
	# P66 (D-92): fixed release-slot routes. Slot a is the single server's
	# port, so both modes share this file and promotion never reloads it.
	handle /ws/slot-a {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /ws/slot-b {
		reverse_proxy 127.0.0.1:8082 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	# Operator status and the P73 internal presence snapshot are loopback-only;
	# never proxy them.
	handle /api/internal/* {
		respond 404
	}
	handle /api/release {
		respond 404
	}
	# P66 + D-97: each generation keeps its own Access index, so an auth
	# request naming its slot (X-TBG-Slot) reaches that slot; unnamed auth
	# requests keep the shared route below. Named matchers keep file order.
	@auth_slot_a {
		path /api/auth/* /api/me/*
		header X-TBG-Slot a
	}
	handle @auth_slot_a {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	@auth_slot_b {
		path /api/auth/* /api/me/*
		header X-TBG-Slot b
	}
	handle @auth_slot_b {
		reverse_proxy 127.0.0.1:8082 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	# P73 privacy barrier (D-103): public profiles/history never fall back to
	# an older slot. Keep slot a privacy-aware even when its match admission
	# is draining or rolled back.
	handle /api/players/* {
		# Deferred so it replaces the upstream profile cache header instead of
		# being sent next to it.
		header {
			Cache-Control "private, no-store"
			defer
		}
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	# Legacy `/ws` clients, health and the explicitly safe read-only APIs (P13
	# ranking with its own 10 s cache headers and per-IP limits, P66
	# admission): every slot reads the same database, so the first live slot
	# answers and a refused connection retries the other one.
	@shared path /ws /health /api/admission /api/live /api/online /api/leaderboard /api/version /api/patch-notes /api/patch-notes/* /api/auth/*
	handle @shared {
		reverse_proxy 127.0.0.1:8080 127.0.0.1:8082 {
			header_up X-Forwarded-For {client_ip}
			lb_policy first
			lb_try_duration 2s
			fail_duration 10s
		}
	}
	# Unnamed owner reads and unknown/encoded API paths fail closed to the
	# privacy-aware process; they cannot reach an older profile handler.
	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

(tbg_updates) {
	# P66: the signed update repository (TUF). Missing files must be real
	# 404s (clients probe the next root version); metadata revalidates,
	# consistent-snapshot targets never change.
	handle_path /updates/* {
		root * /srv/tbg/updates
		@meta path *.json
		header @meta Cache-Control "no-cache"
		@target not path *.json
		header @target Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

__TBG_API_DOMAIN__ {
	encode zstd gzip
	import tbg_api
	import tbg_updates
	handle {
		respond 404
	}
}

__TBG_APP_DOMAIN__ {
	encode zstd gzip
	# Same-origin auth cookies stay on the app host. No permissive CORS.
	import tbg_api
	import tbg_updates
	@game_entry path / /index.html
	handle @game_entry {
		root * /srv/tbg/web
		# A pointer promotion never reloads Caddy or changes an open tab's assets.
		try_files /current/index.html /index.html
		header Cache-Control "no-cache, no-transform"
		file_server
	}
	handle {
		root * /srv/tbg/web
		@immutable_game path /releases/*
		header @immutable_game Cache-Control "public, max-age=31536000, immutable, no-transform"
		# Only the Trunk bundle is content-hashed; /ranking/ files are not.
		@hashed {
			path *.wasm *.js
			not path /ranking/*
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable, no-transform"
		# Unhashed ranking files revalidate every time (ETag, ~15 KB), so a
		# deploy never pairs new HTML with stale JS.
		@html path / /index.html /ranking/*
		header @html Cache-Control "no-cache, no-transform"
		file_server
	}
}

# Static web frontends (landing, www redirect, admin placeholder) live in their own include,
# written only by web/deploy/publish.sh. Relative to this file; an empty glob is only a warning.
import tbg-web/*.caddy
