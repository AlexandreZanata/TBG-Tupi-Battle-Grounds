[Unit]
Description=TBG game server
After=network-online.target
Wants=network-online.target

[Service]
User=tbg
Group=tbg
WorkingDirectory=/var/lib/tbg
# Provisioned browser origin; no credentials belong in this file.
EnvironmentFile=-/etc/tbg/server.env
Environment=TBG_ADDR=127.0.0.1:8080
Environment=TBG_DB=/var/lib/tbg/tbg.sqlite3
ExecStart=/opt/tbg/bin/tbg-server
Restart=always
RestartSec=2
KillSignal=SIGTERM
# P66 (BR-UP06): SIGTERM stops new admissions and waits, without a time
# limit, until running matches end and their results are stored. A stop
# that never finishes is an operator decision, not a timeout.
TimeoutStopSec=infinity
LimitNOFILE=65536
NoNewPrivileges=true
# P14: files the server creates (database, WAL) are private to `tbg`.
UMask=0077

[Install]
WantedBy=multi-user.target
